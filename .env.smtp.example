# Copie somente este bloco para o .env existente; preserve APP_KEY e o banco.
# Preencha os valores no seu computador. Não versione credenciais reais.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=SMTP_DO_SEU_PROVEDOR
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=15
MAIL_USERNAME=SEU_LOGIN_SMTP
MAIL_PASSWORD=SUA_CREDENCIAL_SMTP
MAIL_FROM_ADDRESS=REMETENTE_VERIFICADO
MAIL_FROM_NAME=TotemSync
