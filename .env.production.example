APP_NAME=TotemSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://totem.exemplo.gov.br
APP_DOMAIN=totem.exemplo.gov.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR
APP_FALLBACK_LOCALE=pt-BR
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=totemsync
DB_USERNAME=totemsync
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_COOKIE=totemsync_session

FILESYSTEM_DISK=public
MAIL_MAILER=log
# Configure o SMTP conforme .env.smtp.example antes de criar contas ou recuperar acesso.

APP_IMAGE=ghcr.io/owner/totemsync-app:latest
WEB_IMAGE=ghcr.io/owner/totemsync-web:latest
BACKUP_IMAGE=ghcr.io/owner/totemsync-backup:latest
CERTBOT_EMAIL=administrador@example.gov.br
RESTIC_REPOSITORY=s3:s3.example.com/totemsync-backups
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
